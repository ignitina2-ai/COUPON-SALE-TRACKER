rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'ignitina2@gmail.com',
          'stcasimircharitabletrust@gmail.com'
        ];
    }

    function isAllowedUserDoc(emailStr) {
      return exists(/databases/$(database)/documents/allowedUsers/$(emailStr))
        && (
          get(/databases/$(database)/documents/allowedUsers/$(emailStr)).data.status == 'ACTIVE'
          || get(/databases/$(database)/documents/allowedUsers/$(emailStr)).data.status == 'active'
          || !('status' in get(/databases/$(database)/documents/allowedUsers/$(emailStr)).data)
        );
    }

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          isAllowedUserDoc(request.auth.token.email.lower())
          || isAllowedUserDoc(request.auth.token.email)
        );
    }

    function canUseApp() {
      return isSuperAdmin() || isAllowedUser();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read, write: if canUseApp();
    }

    // Sponsors
    match /sponsors/{sponsorId} {
      allow read, write: if canUseApp();
    }

    // Income and Expenses
    match /incomeExpenses/{incomeExpenseId} {
      allow read, write: if canUseApp();
    }

    // Secretary Handovers
    match /secretaryHandovers/{secretaryHandoverId} {
      allow read, write: if canUseApp();
    }

    // App Settings
    match /settings/{settingsId} {
      allow read, write: if canUseApp();
    }

    // Allowed Users (Whitelist Registry)
    match /allowedUsers/{emailId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isSuperAdmin();
    }

    // Active Sessions (Allows all authenticated and active devices to announce presence)
    match /activeSessions/{sessionId} {
      allow read, write: if canUseApp();
    }

    // Prize Collection (Tracking & Received Amounts - shared trust registry)
    match /prizeCollection/{docId} {
      allow read, write: if canUseApp();
    }

    // Test connection
    match /test/{testId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
  }
}
